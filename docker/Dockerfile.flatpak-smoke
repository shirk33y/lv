# Flatpak smoke test: verify lv.flatpak works with image and video files
# Usage:
#   docker build -f docker/Dockerfile.flatpak-smoke -t lv-flatpak-smoke .
#   docker run --rm -v /path/to/lv.flatpak:/tmp/lv.flatpak:ro lv-flatpak-smoke

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install flatpak and dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    flatpak \
    xvfb \
    xauth \
    xdotool \
    ffmpeg \
    imagemagick \
    libgl1 \
    mesa-utils \
    curl \
    ca-certificates

# Initialize flatpak
RUN flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true
RUN flatpak remote-modify --user --enable flathub || true

# Install runtime and SDK
RUN echo "Installing Freedesktop runtime..." && \
    flatpak install --user --assumeyes \
    org.freedesktop.Platform//24.08 \
    org.freedesktop.Sdk//24.08 \
    org.freedesktop.Platform.ffmpeg-full//24.08 || true

# Copy test files and smoke script
COPY test/fixtures /fixtures
COPY scripts/smoke-test-flatpak.sh /scripts/smoke-test-flatpak.sh

RUN chmod +x /scripts/*.sh
