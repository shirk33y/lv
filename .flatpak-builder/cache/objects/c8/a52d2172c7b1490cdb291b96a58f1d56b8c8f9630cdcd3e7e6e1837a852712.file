        {
          "dest" : "cargo",
          "contents" : "[source.vendored-sources]\ndirectory = \"cargo/vendor\"\n\n[source.crates-io]\nreplace-with = \"vendored-sources\"\n",
          "dest-filename" : "config",
          "type" : "inline"
        },
        {
          "path" : "../Cargo.toml",
          "type" : "file"
        },
        {
          "path" : "../Cargo.lock",
          "type" : "file"
        },
        {
          "path" : "../build.rs",
          "type" : "file"
        },
        {
          "dest" : "src",
          "path" : "../src",
          "type" : "dir"
        },
        {
          "dest" : "assets",
          "path" : "../assets",
          "type" : "dir"
        },
        {
          "dest" : "extra/linux/",
          "path" : "../extra/linux/lv.desktop",
          "type" : "file"
        },
        {
          "dest" : "extra/images/",
          "path" : "../extra/images/lv-256.png",
          "type" : "file"
        },
        {
          "dest" : "extra/images/",
          "path" : "../extra/images/lv.svg",
          "type" : "file"
        },
        {
          "dest" : "extra/flatpak",
          "path" : ".",
          "type" : "dir"
        }
      ],
      "build-options" : {
        "env" : {
          "PKG_CONFIG_PATH" : "/app/lib/pkgconfig",
          "RUSTFLAGS" : "-L/app/lib"
        },
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "prepend-ld-library-path" : "/usr/lib/sdk/rust-stable/lib"
      },
      "post-install" : [
        "install -Dm644 extra/linux/lv.desktop /app/share/applications/com.shirk33y.lv.desktop",
        "install -Dm644 extra/images/lv-256.png /app/share/icons/hicolor/256x256/apps/com.shirk33y.lv.png",
        "install -Dm644 extra/images/lv.svg /app/share/icons/hicolor/scalable/apps/com.shirk33y.lv.svg"
      ],
      "build-commands" : [
        "mkdir -p .cargo",
        "echo '[source.crates-io]\nreplace-with = \"vendored-sources\"\n\n[source.\"vendored-sources\"]\ndirectory = \"cargo/vendor\"' > .cargo/config.toml",
        "cargo build --offline --release",
        "install -Dm755 target/release/lv /app/bin/lv",
        "mkdir -p /app/lib/ffmpeg"
      ]
    }
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--env=LD_LIBRARY_PATH=/app/lib:/app/lib/ffmpeg"
  ],
  "add-extensions" : {
    "org.freedesktop.Platform.ffmpeg-full" : {
      "directory" : "lib/ffmpeg",
      "add-ld-path" : ".",
      "no-autodownload" : true,
      "version" : "24.08"
    }
  },
  "source-date-epoch" : 1777397883
