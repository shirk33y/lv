prefix=/app
includedir=${prefix}/include
libdir=${prefix}/lib

Name: mpv
Description: mpv media player client library
Version: 2.5.0
Requires.private: wayland-client >=  1.21.0, libass >=  0.12.2, libavcodec >=  60.31.102, libavfilter >=  9.12.100, libavformat >=  60.16.100, libavutil >=  58.29.100, libplacebo >= 6.338.2, libswresample >=  4.12.100, libswscale >=  7.5.100, lcms2 >=  2.6, libarchive >=  3.4.0, libavdevice >=  60.3.100, zlib, alsa >=  1.0.18, jack, libpipewire-0.3 >=  0.3.57, libpulse >=  1.0, libjpeg, wayland-cursor >=  1.21.0, wayland-protocols >=  1.31, xkbcommon >=  0.3.0, egl >=  1.4.0, wayland-egl >=  9.0.0, vulkan >=  1.3.238, libva-wayland >=  1.1.0, libva >=  1.1.0
Libs: -L${libdir} -lmpv
Libs.private: -latomic -pthread -lm -lrt
Cflags: -I${includedir}
