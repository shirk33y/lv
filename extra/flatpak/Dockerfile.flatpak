# Flatpak build environment image
# Uses freedesktopsdk/flatpak which includes Flatpak 24.08 SDK + runtimes pre-installed
# Actual build is run via: podman run --privileged (see scripts/build-flatpak.sh)
#
# This image is pre-built by freedesktop SDK project, so it just needs cargo generator

# Flatpak build environment using official Fedora + runtimes
# Runtimes cached in ~/.cache/flatpak volume (managed by build script)

FROM registry.fedoraproject.org/fedora:41

RUN dnf install -y \
    flatpak flatpak-builder python3 python3-pip git curl \
    bubblewrap ostree \
    && dnf clean all

# Add flathub + install runtimes system-wide in the image so build runs can use
# rootless keep-id users without writing repo files as container root.
RUN flatpak remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

RUN flatpak install -y flathub \
    org.freedesktop.Platform//24.08 \
    org.freedesktop.Sdk//24.08 \
    org.freedesktop.Sdk.Extension.rust-stable//24.08

# Cargo generator deps + copy generator
RUN pip3 install --quiet aiohttp toml tomlkit
COPY extra/flatpak/flatpak-cargo-generator.py /usr/local/bin/flatpak-cargo-generator.py
RUN chmod +x /usr/local/bin/flatpak-cargo-generator.py
